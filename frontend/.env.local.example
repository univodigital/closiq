# Local dev: talk to backend directly.
NEXT_PUBLIC_API_URL=http://localhost:8081/api/v1

# Mock payments: leave unset when backend has RAZORPAY_STUB_ENABLED=true (default).
# Checkout skips the Razorpay modal and completes payment instantly.
# Set to false only when using real Razorpay sandbox keys on the backend.

# Vercel production only (server-side proxy target; not exposed to browser):
# NEXT_PUBLIC_API_URL=https://closiq-three.vercel.app/api/v1
# API_PROXY_TARGET=http://YOUR_EC2_PUBLIC_IP:8081
