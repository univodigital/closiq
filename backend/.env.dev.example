# Dev profile environment variables for AWS + Upstash + Supabase.
# Copy to .env.dev locally (gitignored) or use on EC2 / App Runner.
# Full guide: backend/docs/DEV-DEPLOYMENT.md

# --- Spring ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081

# --- Flyway (after manual apply of docs/dev-ddl/closiq-dev-schema.sql) ---
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
SPRING_FLYWAY_BASELINE_VERSION=33

# --- Supabase Postgres (dev project, Mumbai pooler port 6543) ---
DB_HOST=aws-0-ap-south-1.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres
DB_USER=postgres.YOUR_SUPABASE_PROJECT_REF
DB_PASSWORD=
DB_POOL_SIZE=3
SUPABASE_PROJECT_NAME=closiq-dev
SUPABASE_PROJECT_ID=
SUPABASE_REGION=ap-south-1

# --- Upstash Redis (AWS Mumbai ap-south-1, TLS required) ---
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_SSL=true

# --- Auth ---
JWT_SECRET=
REFRESH_COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://closiq-three.vercel.app
APP_BASE_URL=https://closiq-three.vercel.app

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=closiq-dev
CLOUDINARY_STUB_ENABLED=false

# --- Razorpay (sandbox for dev) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_STUB_ENABLED=true

# --- Shadowfax (stub for dev) ---
SHADOWFAX_WEBHOOK_SECRET=shadowfax_stub_webhook_secret
SHADOWFAX_STUB_ENABLED=true

# --- Email (optional) ---
MAIL_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Closiq
