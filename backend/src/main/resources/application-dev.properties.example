# Copy to application-dev.properties (gitignored) and fill in secrets.
# Active profile: dev — see backend/docs/DEV-DEPLOYMENT.md for GCP + Upstash setup.
#
#   cp src/main/resources/application-dev.properties.example \
#      src/main/resources/application-dev.properties

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false

server.port=${SERVER_PORT:8081}

# ---------------------------------------------------------------------------
# Supabase (dev database — Mumbai pooler, transaction mode)
# Dashboard: Project Settings → Database → Connection string (Pooler, IPv4)
# ---------------------------------------------------------------------------
spring.datasource.url=jdbc:postgresql://${DB_HOST:localhost}:${DB_PORT:6543}/${DB_NAME:postgres}?prepareThreshold=0
spring.datasource.username=${DB_USER:}
spring.datasource.password=${DB_PASSWORD:}
spring.datasource.hikari.maximum-pool-size=${DB_POOL_SIZE:3}
spring.datasource.hikari.minimum-idle=1
spring.datasource.hikari.max-lifetime=300000
spring.datasource.hikari.idle-timeout=60000

closiq.supabase.project-name=${SUPABASE_PROJECT_NAME:closiq-dev}
closiq.supabase.project-id=${SUPABASE_PROJECT_ID:}
closiq.supabase.region=${SUPABASE_REGION:ap-south-1}

# ---------------------------------------------------------------------------
# Upstash Redis (dev — AWS Mumbai ap-south-1, TLS required)
# Dashboard: closiq-redis → Details → redis-cli command
# ---------------------------------------------------------------------------
spring.data.redis.host=${REDIS_HOST:localhost}
spring.data.redis.port=${REDIS_PORT:6379}
spring.data.redis.password=${REDIS_PASSWORD:}
spring.data.redis.ssl.enabled=${REDIS_SSL:true}

# ---------------------------------------------------------------------------
# Flyway — see docs/DEV-DEPLOYMENT.md for DDL-only vs seed migrations
# ---------------------------------------------------------------------------
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=0

# ---------------------------------------------------------------------------
# Auth & CORS (dev)
# ---------------------------------------------------------------------------
closiq.jwt.secret=${JWT_SECRET:change-me-use-at-least-256-bits-for-dev}
closiq.otp.console-log-enabled=true
closiq.auth.refresh-cookie-secure=${REFRESH_COOKIE_SECURE:false}

# Vercel preview + local frontend
closiq.cors.allowed-origins=${CORS_ALLOWED_ORIGINS:http://localhost:3000,http://127.0.0.1:3000,https://closiq-three.vercel.app}
closiq.notification.app-base-url=${APP_BASE_URL:https://closiq-three.vercel.app}

# ---------------------------------------------------------------------------
# Email (optional — OTP logs to console when disabled)
# ---------------------------------------------------------------------------
closiq.mail.enabled=${MAIL_ENABLED:false}
closiq.mail.from=${MAIL_FROM:noreply@closiq.com}
closiq.mail.from-name=${MAIL_FROM_NAME:Closiq}
brevo.api-key=${BREVO_API_KEY:}
brevo.sender-email=${BREVO_SENDER_EMAIL:}
brevo.sender-name=${BREVO_SENDER_NAME:Closiq}

# ---------------------------------------------------------------------------
# Cloudinary (real uploads in dev)
# ---------------------------------------------------------------------------
closiq.cloudinary.cloud-name=${CLOUDINARY_CLOUD_NAME:${CLOSIQ_CLOUDINARY_CLOUD_NAME:}}
closiq.cloudinary.api-key=${CLOUDINARY_API_KEY:${CLOSIQ_CLOUDINARY_API_KEY:}}
closiq.cloudinary.api-secret=${CLOUDINARY_API_SECRET:${CLOSIQ_CLOUDINARY_API_SECRET:}}
closiq.cloudinary.folder=${CLOUDINARY_FOLDER:${CLOSIQ_CLOUDINARY_FOLDER:closiq-dev}}
closiq.cloudinary.stub-enabled=${CLOUDINARY_STUB_ENABLED:false}
closiq.s3.stub-enabled=true

# ---------------------------------------------------------------------------
# Payments & logistics (Razorpay sandbox; Shadowfax stub unless configured)
# ---------------------------------------------------------------------------
closiq.razorpay.key-id=${RAZORPAY_KEY_ID:}
closiq.razorpay.key-secret=${RAZORPAY_KEY_SECRET:}
closiq.razorpay.stub-enabled=${RAZORPAY_STUB_ENABLED:true}
closiq.shadowfax.webhook-secret=${SHADOWFAX_WEBHOOK_SECRET:shadowfax_stub_webhook_secret}
closiq.shadowfax.stub-enabled=${SHADOWFAX_STUB_ENABLED:true}

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
logging.level.com.closiq=DEBUG
logging.level.org.springframework.security=INFO
