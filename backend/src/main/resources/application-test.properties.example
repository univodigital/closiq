# Copy to application-test.properties and fill in values (that file is gitignored).
# spring.profiles.active=test is set in application.properties

spring.jpa.hibernate.ddl-auto=validate
spring.jpa.show-sql=false

server.port=8081

closiq.jwt.secret=${JWT_SECRET:change-me-use-at-least-256-bits}
closiq.otp.console-log-enabled=true

# Email (optional — when disabled, OTP/welcome emails log to console)
closiq.mail.enabled=${MAIL_ENABLED:false}
closiq.mail.from=${MAIL_FROM:noreply@closiq.com}
closiq.mail.from-name=${MAIL_FROM_NAME:Closiq}
brevo.api-key=${BREVO_API_KEY:}
brevo.sender-email=${BREVO_SENDER_EMAIL:}
brevo.sender-name=${BREVO_SENDER_NAME:Closiq}

logging.level.com.closiq=INFO

# Supabase
closiq.supabase.project-name=${SUPABASE_PROJECT_NAME:closiq-test}
closiq.supabase.project-id=${SUPABASE_PROJECT_ID:}
closiq.supabase.region=${SUPABASE_REGION:ap-south-1}

# Supabase pooler (IPv4). Port 6543 = transaction mode (recommended for app servers).
# Port 5432 = session mode (15-connection cap on free tier). prepareThreshold=0 required for 6543.
spring.datasource.url=jdbc:postgresql://${DB_HOST:aws-0-ap-south-1.pooler.supabase.com}:${DB_PORT:6543}/${DB_NAME:postgres}?prepareThreshold=0
spring.datasource.username=${DB_USER:}
spring.datasource.password=${DB_PASSWORD:}
spring.datasource.hikari.maximum-pool-size=${DB_POOL_SIZE:3}
spring.datasource.hikari.minimum-idle=1
spring.datasource.hikari.max-lifetime=300000
spring.datasource.hikari.idle-timeout=60000

spring.data.redis.host=${REDIS_HOST:localhost}
spring.data.redis.port=${REDIS_PORT:6379}

spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=0

# Cloudinary
closiq.cloudinary.cloud-name=${CLOUDINARY_CLOUD_NAME:}
closiq.cloudinary.api-key=${CLOUDINARY_API_KEY:}
closiq.cloudinary.api-secret=${CLOUDINARY_API_SECRET:}
closiq.cloudinary.folder=${CLOUDINARY_FOLDER:closiq}
closiq.cloudinary.stub-enabled=false
closiq.s3.stub-enabled=true

closiq.auth.refresh-cookie-secure=false

# Razorpay (sandbox)
closiq.razorpay.key-id=${RAZORPAY_KEY_ID:}
closiq.razorpay.key-secret=${RAZORPAY_KEY_SECRET:}
closiq.razorpay.stub-enabled=false
